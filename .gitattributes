# Set default behavior to automatically normalize text line endings to LF
* text=auto eol=lf

# Force bash/shell scripts to always use LF (prevents \r errors in Git Bash on Windows)
*.sh text eol=lf

# Force Windows batch files to use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Source code files
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.py text eol=lf
*.css text eol=lf
*.md text eol=lf
*.svg text eol=lf

# Binary files
*.db binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
